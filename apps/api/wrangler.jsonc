{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "songbook-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songbook",
      // Local-only prototype. For deploy: `wrangler d1 create songbook` and paste the real id.
      "database_id": "local-songbook",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEV_MODE": "true",
    "ADMIN_EMAILS": "admin@example.com",
    "MAIL_FROM": "Songbook <songbook@example.com>",
    "APPLE_ISSUER": "https://appleid.apple.com",
    // Expo Go signs Apple tokens for its own bundle id; add your bundle id for dev builds.
    "APPLE_AUDIENCE": "host.exp.Exponent",
    "GOOGLE_ISSUER": "https://accounts.google.com",
    // Comma-separated OAuth client ids (iOS, Android, web).
    "GOOGLE_AUDIENCE": ""
  },
  // `wrangler deploy --env production`. ADMIN_EMAILS and RESEND_API_KEY are secrets
  // (`wrangler secret put … --env production`), so they stay out of this public file.
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "songbook",
          "database_id": "26f70d7b-fe47-4d4a-b46f-34d9168b082e",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "DEV_MODE": "false",
        "MAIL_FROM": "Songbook <songbook@example.com>",
        "APPLE_ISSUER": "https://appleid.apple.com",
        "APPLE_AUDIENCE": "com.mattmsh.songbook",
        "GOOGLE_ISSUER": "https://accounts.google.com",
        "GOOGLE_AUDIENCE": ""
      }
    }
  }
}
